{
  "operation": "build_graph",
  "params": {
    "name": "BookBarcode generation flow",
    "nodes": [
      {"id": "input", "label": "ISBN input", "kind": "input"},
      {"id": "validate", "label": "Validate ISBN", "kind": "step"},
      {"id": "encode", "label": "Encode EAN-13", "kind": "step"},
      {"id": "render", "label": "Render artifact", "kind": "step"},
      {"id": "output", "label": "SVG or PDF", "kind": "output"}
    ],
    "edges": [
      {"source": "input", "target": "validate", "kind": "next"},
      {"source": "validate", "target": "encode", "kind": "next"},
      {"source": "encode", "target": "render", "kind": "next"},
      {"source": "render", "target": "output", "kind": "produces"}
    ],
    "require_acyclic": true
  }
}
